# Copy to .env.local and fill in from the Clerk and Supabase dashboards.
# On Vercel, set the same names in Project Settings → Environment Variables.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Hosted Account Portal URLs from the Clerk dashboard (Paths).
# Use your app's /sign-in and /sign-up only after those paths are set to this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# https://<project-ref>.supabase.co  (not the sb_publishable_ key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
